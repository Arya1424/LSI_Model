{
  "seed": 42,
  "do_train_dev": true,
  "do_test": false,
  "do_infer": false,
  
  "use_trie": true,
  "use_orwell": true,
  "use_kdtree": false,
  "k_neighbors": 10,
  
  "vocab_limit": 10000,
